exports[`render frontmatter as table above the body 1`] = `
"<!doctype html>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hello</title>
<style>:root {
  --bg: #fff;
  --fg: #1f2328;
  --muted: #59636e;
  --border: #d1d9e0;
  --code-bg: #f6f8fa;
  --accent: #0969da;
  --kw: #cf222e;
  --str: #0a3069;
  --cmt: #6e7781;
  --num: #0550ae;
  --fn: #8250df;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0d1117;
    --fg: #e6edf3;
    --muted: #9198a1;
    --border: #30363d;
    --code-bg: #161b22;
    --accent: #4493f8;
    --kw: #ff7b72;
    --str: #a5d6ff;
    --cmt: #8b949e;
    --num: #79c0ff;
    --fn: #d2a8ff;
  }
}
* {
  box-sizing: border-box;
}
body {
  margin: 0 auto;
  max-width: 80rem;
  padding: 2rem 2rem 6rem;
  font:
    16px/1.65 -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    Helvetica,
    Arial,
    sans-serif;
  color: var(--fg);
  background: var(--bg);
}
h1,
h2,
h3,
h4,
h5,
h6 {
  margin: 1.6em 0 0.6em;
  line-height: 1.3;
  font-weight: 650;
}
h1,
h2 {
  border-bottom: 1px solid var(--border);
  padding-bottom: 0.3em;
}
p,
ul,
ol,
blockquote,
table,
pre {
  margin: 0.8em 0;
}
ul,
ol {
  padding-left: 1.5em;
}
a {
  color: var(--accent);
  text-decoration: none;
}
a:hover {
  text-decoration: underline;
}
img,
video {
  max-width: 100%;
}
blockquote {
  padding: 0.1em 1em;
  border-left: 0.25em solid var(--border);
  color: var(--muted);
}
hr {
  border: 0;
  border-top: 1px solid var(--border);
  margin: 2em 0;
}
table {
  border-collapse: collapse;
  display: block;
  max-width: 100%;
  overflow: auto;
}
th,
td {
  border: 1px solid var(--border);
  padding: 0.35em 0.6em;
  text-align: left;
}
thead th {
  background: var(--code-bg);
}
code {
  font-family:
    ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
  font-size: 0.875em;
  background: var(--code-bg);
  border-radius: 5px;
  padding: 0.15em 0.35em;
}
pre {
  background: var(--code-bg);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 0.9em 1.1em;
  overflow-x: auto;
  line-height: 1.55;
}
pre code {
  display: block;
  background: none;
  padding: 0;
  font-size: 0.85em;
}
li:has(> input[type="checkbox"]) {
  list-style: none;
  margin-left: -1.3em;
}
.frontmatter {
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 0.4em 0.75em;
  margin: 0 0 1.5em;
  font-size: 0.85em;
  color: var(--muted);
}
.frontmatter table {
  display: table;
  margin: 0;
}
.frontmatter th,
.frontmatter td {
  border: 0;
  padding: 0.1em 1em 0.1em 0;
}
.hljs {
  color: var(--fg);
}
.hljs-comment,
.hljs-quote {
  color: var(--cmt);
  font-style: italic;
}
.hljs-keyword,
.hljs-selector-tag,
.hljs-doctag,
.hljs-name,
.hljs-tag {
  color: var(--kw);
}
.hljs-string,
.hljs-regexp,
.hljs-symbol,
.hljs-bullet,
.hljs-addition,
.hljs-meta .hljs-string {
  color: var(--str);
}
.hljs-number,
.hljs-literal,
.hljs-attr,
.hljs-attribute,
.hljs-selector-id,
.hljs-selector-class,
.hljs-selector-attr,
.hljs-selector-pseudo,
.hljs-section,
.hljs-variable,
.hljs-template-variable {
  color: var(--num);
}
.hljs-title,
.hljs-function,
.hljs-built_in,
.hljs-type,
.hljs-class {
  color: var(--fn);
}
.hljs-emphasis {
  font-style: italic;
}
.hljs-strong {
  font-weight: 600;
}
pre.mermaid {
  overflow: hidden;
  cursor: grab;
  touch-action: none;
  user-select: none;
}
pre.mermaid:active {
  cursor: grabbing;
}
</style>
<div class="frontmatter"><table class="frontmatter"><tr><th>title</th><td>x</td></tr><tr><th>tags</th><td>[&quot;a&quot;,&quot;b&quot;]</td></tr><tr><th>meta</th><td>{&quot;y&quot;:1}</td></tr></table></div>
<hr>
<h1>Hello</h1>
<p><strong>world</strong></p>"
`;

